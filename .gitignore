# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
work/pos/.next/

# producción local
/build

# base de datos local (los datos reales viajan en prisma/datos-iniciales.json)
/db/*.db
/db/*.db-journal
/db/*.db.respaldo-*
work/pos/db/*.db-journal

# instaladores grandes: van a GitHub Releases, nunca al repositorio
central-files/updates/*.exe
work/**/*.exe
work/electron-base/
work/nsis/
work/src/
work/staging/
work/dist/
*.zip

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log
build64.log

# env files (las credenciales viven solo en el panel de Vercel)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# carpetas del entorno de desarrollo original (no forman parte del sitio)
/skills/
/examples/
/mini-services/
/tests/
/.zscripts/
/.z-ai-config
/.claude
/upload/
/download/
local-*
prompt
