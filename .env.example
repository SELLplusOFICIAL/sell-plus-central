# ============================================================
# Sell-Plus Central — variables de entorno
# Copia este archivo como ".env" para desarrollo local:
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux:         cp .env.example .env
# ============================================================

# --- Desarrollo local (SQLite, obligatoria) ---
# En local la base vive en la carpeta db/ del proyecto.
DATABASE_URL="file:./db/custom.db"

# Raíz de la Central si el servidor corre desde otra carpeta (opcional).
# Deja que code, base de datos e instaladores vivan en el mismo lugar.
# CENTRAL_RAIZ=/ruta/absoluta/a/sell-plus-central

# ------------------------------------------------------------
# Las siguientes SOLO se configuran en el panel de Vercel
# (Settings → Environment Variables), nunca aquí:
#
# DATABASE_URL        → cadena PostgreSQL de Neon (obligatoria en Vercel)
# CENTRAL_ADMIN_KEY   → tu clave privada para acciones de administrador
#                       (si no se define, se usa la clave histórica
#                       "sellplus-admin-2026"; se recomienda cambiarla)
# NEXT_PUBLIC_BASE_URL→ fija el origen público, p. ej.
#                       https://sell-plus-central.vercel.app (opcional:
#                       Vercel lo detecta solo)
# GITHUB_RELEASES_BASE→ https://github.com/USUARIO/sell-plus-central/releases/download
#                       (opcional: en Vercel se deduce automáticamente)
# ------------------------------------------------------------
